[
  { "command": "add", "path": "$.contractRole", "value": "RPA",
    "title": "Defaults",
    "description": "Terms the ACTUS PAM contract may leave out, with the defaults ACTUS-I's PamContractTerms.FromDictionary applies. Everything else is read only when its own feature is switched on (a cycle, a purchase date, ...)." },
  { "command": "add", "path": "$.dayCountConvention", "value": "A365" },
  { "command": "add", "path": "$.notionalPrincipal", "value": 0 },
  { "command": "add", "path": "$.nominalInterestRate", "value": 0 },
  { "command": "add", "path": "$.premiumDiscountAtIED", "value": 0 },
  { "command": "add", "path": "$.accruedInterest", "value": 0 },
  { "command": "add", "path": "$.priceAtPurchaseDate", "value": 0 },
  { "command": "add", "path": "$.priceAtTerminationDate", "value": 0 },
  { "command": "add", "path": "$.feeRate", "value": 0 },
  { "command": "add", "path": "$.feeAccrued", "value": 0 },
  { "command": "add", "path": "$.rateMultiplier", "value": 1 },
  { "command": "add", "path": "$.rateSpread", "value": 0 },
  { "command": "add", "path": "$.lifeFloor", "value": -1e300, "description": "ACTUS life and period caps and floors default to minus and plus infinity; a very large number stands in for it." },
  { "command": "add", "path": "$.lifeCap", "value": 1e300 },
  { "command": "add", "path": "$.periodFloor", "value": -1e300 },
  { "command": "add", "path": "$.periodCap", "value": 1e300 },
  { "command": "add", "path": "$.notionalScalingMultiplier", "value": 1 },
  { "command": "add", "path": "$.interestScalingMultiplier", "value": 1 },
  { "command": "add", "path": "$.scalingIndexAtContractDealDate", "value": 0 },
  { "command": "add", "path": "$.endOfMonth", "value": false },
  { "command": "add", "path": "$.businessDayConvention", "value": "NOS" },
  { "command": "add", "path": "$.calendar", "value": "NC" },

  { "command": "put", "path": "$.w.role",
    "value": "=if(=matches($.contractRole,'(?i)^(RPL|SEL|PFL|PF)$'),-1,1)",
    "title": "Derived switches",
    "description": "Cash-flow sign of the role: RPA, BUY, RFL and RF receive (+1); RPL, SEL, PFL and PF pay (-1). An unknown role is RPA, as in ACTUS-I." },
  { "command": "put", "path": "$.w.dccn", "value": "=toUpper(=replace(=replace($.dayCountConvention,'/',''),'_',''))" },
  { "command": "put", "path": "$.w.dcc",
    "value": "=if(=matches($.w.dccn,'^(AA|AAISDA)$'),'AA',=if(=equals($.w.dccn,'A360'),'A360',=if(=equals($.w.dccn,'A365'),'A365',=if(=equals($.w.dccn,'30E360ISDA'),'30E360ISDA',=if(=equals($.w.dccn,'30E360'),'30E360',=if(=equals($.w.dccn,'B252'),'B252',=if(=equals($.w.dccn,'A336'),'A336','A365')))))))",
    "description": "Day count convention, spelling normalised (A/365, A_365, a365 are one). An unknown name is A365, as in ACTUS-I." },
  { "command": "put", "path": "$.w.bdc", "value": "=toUpper($.businessDayConvention)" },
  { "command": "put", "path": "$.w.bdActive",
    "value": "=and(=matches($.calendar,'(?i)^(MF|MFH)$'),=matches($.w.bdc,'^(CSF|CSMF|CSP|CSMP|SCF|SCMF|SCP|SCMP)$'))",
    "description": "A business-day convention only moves dates on the Monday-to-Friday calendars (MF, and MFH, whose holiday list ACTUS-I builds empty). On NC, or with NOS, it changes nothing." },
  { "command": "put", "path": "$.w.bdKind", "value": "=replace(=replace($.w.bdc,'SC',''),'CS','')" },
  { "command": "put", "path": "$.w.bdShiftCalc", "value": "=startsWith($.w.bdc,'SC')" },
  { "command": "put", "path": "$.w.hasPurchase", "value": "=exists($.purchaseDate)" },
  { "command": "put", "path": "$.w.purchase", "value": "=if(=exists($.purchaseDate),$.purchaseDate,'1900-01-01')" },
  { "command": "put", "path": "$.w.hasTermination", "value": "=exists($.terminationDate)" },
  { "command": "put", "path": "$.w.termination", "value": "=if(=exists($.terminationDate),$.terminationDate,'2999-12-31')" },
  { "command": "put", "path": "$.w.mat10", "value": "=substring($.maturityDate,0,10)" },
  { "command": "put", "path": "$.w.rFloor", "value": "=if(=exists($.rateFloor),$.rateFloor,-1000000)",
    "description": "Optional floor (ACTUS RRLF) and cap (RRLC) on the nominal interest rate: a variant on top of ACTUS-I's own life and period bounds, which are applied first. A missing bound is a million either way, so clamp() leaves the rate untouched." },
  { "command": "put", "path": "$.w.rCap", "value": "=if(=exists($.rateCap),$.rateCap,1000000)" },
  { "command": "put", "path": "$.w.hasCap", "value": "=exists($.capitalizationEndDate)" },
  { "command": "put", "path": "$.w.cap", "value": "=if(=exists($.capitalizationEndDate),$.capitalizationEndDate,'1900-01-01')" },
  { "command": "put", "path": "$.w.hasNext", "value": "=exists($.nextResetRate)" },
  { "command": "put", "path": "$.w.rrMarket", "value": "=or(=exists($.marketObjectCodeOfRateReset),=exists($.marketData))" },
  { "command": "put", "path": "$.w.feeIsA", "value": "=if(=exists($.feeBasis),=equals($.feeBasis,'A'),false)" },
  { "command": "put", "path": "$.w.feeAccrues", "value": "=if(=exists($.feeBasis),=equals($.feeBasis,'N'),false)",
    "description": "Fees accrue only on basis N. With no basis at all ACTUS-I neither accrues nor pays on basis A; the payment then uses the N formula on whatever is accrued." },
  { "command": "put", "path": "$.w.scN", "value": "=matches($.scalingEffect,'N')" },
  { "command": "put", "path": "$.w.scI", "value": "=matches($.scalingEffect,'I')" },
  { "command": "put", "path": "$.w.hasIpCycle", "value": "=or(=exists($.cycleOfInterestPayment),=exists($.interestPaymentCycle))" },
  { "command": "put", "path": "$.w.iedAnchorOn",
    "value": "=if(=exists($.interestPaymentAnchor),=lessThan($.interestPaymentAnchor,$.initialExchangeDate),false)",
    "description": "An interest payment anchor before the initial exchange makes the IED accrue interest from that anchor." },

  { "command": "put", "path": "$.w.sched",
    "title": "The four cycles",
    "description": "Interest payment, rate reset, fee and scaling. Each entry carries the raw cycle text (ACTUS 'P1M15DL1', '3M') and, for the older input form, an object { count, unit, longStub }. A missing cycle is 'anchor and maturity only' (a single 1000-year period), which is how ACTUS treats a schedule without a cycle; the interest schedule is always on and its anchor defaults to the initial exchange date. Rate reset and scaling never add the maturity date.",
    "value": [
      { "tag": "IP",
        "on": true,
        "text": "=if(=exists($.cycleOfInterestPayment),$.cycleOfInterestPayment,'')",
        "hasObj": "=exists($.interestPaymentCycle)",
        "oc": "=if(=exists($.interestPaymentCycle),$.interestPaymentCycle.count,0)",
        "ou": "=if(=exists($.interestPaymentCycle),$.interestPaymentCycle.unit,'years')",
        "os": "=if(=exists($.interestPaymentCycle),$.interestPaymentCycle.longStub,false)",
        "anchor": "=if(=exists($.interestPaymentAnchor),$.interestPaymentAnchor,$.initialExchangeDate)",
        "includeEnd": true },
      { "tag": "RR",
        "on": "=or(=exists($.cycleOfRateReset),=exists($.rateResetCycle))",
        "text": "=if(=exists($.cycleOfRateReset),$.cycleOfRateReset,'')",
        "hasObj": "=exists($.rateResetCycle)",
        "oc": "=if(=exists($.rateResetCycle),$.rateResetCycle.count,0)",
        "ou": "=if(=exists($.rateResetCycle),$.rateResetCycle.unit,'years')",
        "os": "=if(=exists($.rateResetCycle),$.rateResetCycle.longStub,false)",
        "anchor": "=if(=exists($.rateResetAnchor),$.rateResetAnchor,$.initialExchangeDate)",
        "includeEnd": false },
      { "tag": "FP",
        "on": "=or(=exists($.cycleOfFee),=exists($.feeCycle))",
        "text": "=if(=exists($.cycleOfFee),$.cycleOfFee,'')",
        "hasObj": "=exists($.feeCycle)",
        "oc": "=if(=exists($.feeCycle),$.feeCycle.count,0)",
        "ou": "=if(=exists($.feeCycle),$.feeCycle.unit,'years')",
        "os": "=if(=exists($.feeCycle),$.feeCycle.longStub,false)",
        "anchor": "=if(=exists($.feeAnchor),$.feeAnchor,$.initialExchangeDate)",
        "includeEnd": true },
      { "tag": "SC",
        "on": "=matches($.scalingEffect,'[IN]')",
        "text": "=if(=exists($.cycleOfScalingIndex),$.cycleOfScalingIndex,'')",
        "hasObj": false,
        "oc": 0,
        "ou": "years",
        "os": false,
        "anchor": "=if(=exists($.scalingAnchor),$.scalingAnchor,$.initialExchangeDate)",
        "includeEnd": false }
    ] },

  { "command": "put", "path": "$.w.bad", "value": false,
    "title": "Read the cycles",
    "description": "Cycle grammar of ACTUS-I's CycleUtils: an ISO period P{n}Y{n}M{n}D or a bare {n}D, {n}M, {n}Q, {n}H, {n}Y, optionally followed by L0 (long stub) or L1 (short stub, also the default). P1Q, P1H, P2W or a stub other than 0 and 1 are not accepted. Of a compound period only the largest unit counts (years, else months, else days), as in ACTUS-I. An unsupported cycle that would build a schedule fails the whole script." },
  { "command": "forEach", "path": "$.w.sched", "commands": [
      { "command": "put", "path": "$.w.c.tag", "value": "@.tag" },
      { "command": "put", "path": "$.w.c.on", "value": "@.on" },
      { "command": "put", "path": "$.w.c.tx", "value": "@.text" },
      { "command": "put", "path": "$.w.c.hasObj", "value": "@.hasObj" },
      { "command": "put", "path": "$.w.c.oc", "value": "@.oc" },
      { "command": "put", "path": "$.w.c.ou", "value": "@.ou" },
      { "command": "put", "path": "$.w.c.os", "value": "@.os" },
      { "command": "put", "path": "$.w.c.anchor", "value": "@.anchor" },
      { "command": "put", "path": "$.w.c.inc", "value": "@.includeEnd" },
      { "command": "put", "path": "$.w.c.cnt", "value": 1000 },
      { "command": "put", "path": "$.w.c.unit", "value": "years" },
      { "command": "put", "path": "$.w.c.long", "value": false },
      { "command": "ifElse", "condition": "=notEquals($.w.c.tx,'')",
        "ifScript": [
          { "command": "put", "path": "$.w.c.pp", "value": "=regexExtract($.w.c.tx,'^[^L]*')" },
          { "command": "put", "path": "$.w.c.stub", "value": "=regexExtract($.w.c.tx,'^[^L]*L(.)',1)" },
          { "command": "put", "path": "$.w.c.stubOk", "value": "=or(=not(=contains($.w.c.tx,'L')),=matches($.w.c.stub,'^[01]$'))" },
          { "command": "put", "path": "$.w.c.iso", "value": "=startsWith($.w.c.pp,'P')" },
          { "command": "put", "path": "$.w.c.pOk",
            "value": "=if($.w.c.iso,=and(=matches($.w.c.pp,'^P(\\d+Y)?(\\d+M)?(\\d+D)?$'),=notEquals($.w.c.pp,'P')),=matches(=toUpper($.w.c.pp),'^\\d+[DMQHY]$'))" },
          { "command": "put", "path": "$.w.c.ok", "value": "=and($.w.c.stubOk,$.w.c.pOk)" },
          { "command": "ifElse", "condition": "=fetch($.w.c.ok)",
            "ifScript": [
              { "command": "put", "path": "$.w.c.y", "value": "=if($.w.c.iso,=regexExtract($.w.c.pp,'^P(?:(\\d+)Y)?(?:(\\d+)M)?(?:(\\d+)D)?$',1),'')" },
              { "command": "put", "path": "$.w.c.m", "value": "=if($.w.c.iso,=regexExtract($.w.c.pp,'^P(?:(\\d+)Y)?(?:(\\d+)M)?(?:(\\d+)D)?$',2),'')" },
              { "command": "put", "path": "$.w.c.d", "value": "=if($.w.c.iso,=regexExtract($.w.c.pp,'^P(?:(\\d+)Y)?(?:(\\d+)M)?(?:(\\d+)D)?$',3),'')" },
              { "command": "put", "path": "$.w.c.cn", "value": "=if($.w.c.iso,'0',=regexExtract(=toUpper($.w.c.pp),'^(\\d+)[DMQHY]$',1))" },
              { "command": "put", "path": "$.w.c.cu", "value": "=if($.w.c.iso,'',=regexExtract(=toUpper($.w.c.pp),'^\\d+([DMQHY])$',1))" },
              { "command": "put", "path": "$.w.c.yi",
                "value": "=if($.w.c.iso,=if(=isEmpty($.w.c.y),0,=sum(0,$.w.c.y)),=if(=equals($.w.c.cu,'Y'),=sum(0,$.w.c.cn),0))" },
              { "command": "put", "path": "$.w.c.mi",
                "value": "=if($.w.c.iso,=if(=isEmpty($.w.c.m),0,=sum(0,$.w.c.m)),=if(=equals($.w.c.cu,'M'),=sum(0,$.w.c.cn),=if(=equals($.w.c.cu,'Q'),=multiply(3,$.w.c.cn),=if(=equals($.w.c.cu,'H'),=multiply(6,$.w.c.cn),0))))" },
              { "command": "put", "path": "$.w.c.di",
                "value": "=if($.w.c.iso,=if(=isEmpty($.w.c.d),0,=sum(0,$.w.c.d)),=if(=equals($.w.c.cu,'D'),=sum(0,$.w.c.cn),0))" },
              { "command": "set", "path": "$.w.c.cnt",
                "value": "=if(=greaterThan($.w.c.yi,0),$.w.c.yi,=if(=greaterThan($.w.c.mi,0),$.w.c.mi,$.w.c.di))",
                "description": "A cycle of length zero would never advance; ACTUS-I loops forever on it, this script rejects it." },
              { "command": "set", "path": "$.w.c.unit",
                "value": "=if(=greaterThan($.w.c.yi,0),'years',=if(=greaterThan($.w.c.mi,0),'months','days'))" },
              { "command": "set", "path": "$.w.c.long", "value": "=equals($.w.c.stub,'0')" },
              { "command": "ifElse", "condition": "=and($.w.c.on,=equals($.w.c.cnt,0))",
                "ifScript": [ { "command": "set", "path": "$.w.bad", "value": true } ] }
            ],
            "elseScript": [
              { "command": "ifElse", "condition": "=fetch($.w.c.on)",
                "ifScript": [ { "command": "set", "path": "$.w.bad", "value": true } ] }
            ] }
        ],
        "elseScript": [
          { "command": "ifElse", "condition": "=fetch($.w.c.hasObj)",
            "ifScript": [
              { "command": "set", "path": "$.w.c.cnt", "value": "=fetch($.w.c.oc)" },
              { "command": "set", "path": "$.w.c.unit", "value": "=fetch($.w.c.ou)" },
              { "command": "set", "path": "$.w.c.long", "value": "=fetch($.w.c.os)" }
            ] }
        ] },
      { "command": "set", "path": "@",
        "value": { "tag": "=fetch($.w.c.tag)", "on": "=fetch($.w.c.on)", "count": "=fetch($.w.c.cnt)",
                   "unit": "=fetch($.w.c.unit)", "longStub": "=fetch($.w.c.long)",
                   "anchor": "=fetch($.w.c.anchor)", "includeEnd": "=fetch($.w.c.inc)" } }
  ] },
  { "command": "ifElse", "condition": "=fetch($.w.bad)",
    "ifScript": [
      { "command": "put", "path": "$.w.unsupportedCycle", "value": "=regexExtract('x','x',9)",
        "description": "TLio has no fail command. Asking regexExtract for a capture group its pattern does not have is an authoring error, so it fails the script: this is the deliberate failure for an unsupported cycle." }
    ] },

  { "command": "put", "path": "$.w.raw", "value": "=concat('ST|',$.statusDate)",
    "title": "Schedules: one 'TYPE|date' token per event",
    "description": "The first token is the status date: it is not an event, it only gets its calculation date (the status date is shifted like an event date under the SC conventions)." },
  { "command": "put", "path": "$.w.emit", "value": "" },
  { "command": "put", "path": "$.w.et", "value": "" },
  { "command": "put", "path": "$.w.lastIp", "value": "",
    "description": "The last interest payment date before the status date: where interest accrued before the status date started." },
  { "command": "forEach", "path": "$.w.sched", "commands": [
      { "command": "put", "path": "$.w.tag", "value": "@.tag" },
      { "command": "put", "path": "$.w.on", "value": "@.on" },
      { "command": "put", "path": "$.w.anchor", "value": "@.anchor" },
      { "command": "put", "path": "$.w.count", "value": "@.count" },
      { "command": "put", "path": "$.w.unit", "value": "@.unit" },
      { "command": "put", "path": "$.w.longStub", "value": "@.longStub" },
      { "command": "put", "path": "$.w.inc", "value": "=if(@.includeEnd,1,0)" },
      { "command": "ifElse", "condition": "=fetch($.w.on)",
        "ifScript": [
          { "command": "put", "path": "$.w.eom",
            "value": "=and($.endOfMonth,=and(=equals($.w.anchor,=endOfMonth($.w.anchor)),=notEquals($.w.unit,'days')))" },
          { "command": "put", "path": "$.w.k", "value": 0 },
          { "command": "put", "path": "$.w.last", "value": "" },
          { "command": "put", "path": "$.w.cur", "value": "$.w.anchor" },
          { "command": "while", "condition": "=lessThan($.w.cur,$.maturityDate)", "maxIterations": 5000,
            "commands": [
              { "command": "put", "path": "$.w.nxt",
                "value": "=dateAdd($.w.anchor,=multiply($.w.count,=sum($.w.k,1)),$.w.unit)" },
              { "command": "ifElse", "condition": "=fetch($.w.eom)",
                "ifScript": [ { "command": "set", "path": "$.w.nxt", "value": "=endOfMonth($.w.nxt)" } ] },
              { "command": "put", "path": "$.w.skip",
                "value": "=and($.w.longStub,=and(=greaterThan($.w.nxt,$.maturityDate),=greaterThan(=sum($.w.k,1,$.w.inc),2)))",
                "description": "Long stub: when the schedule does not land on maturity, the last regular date is dropped so the final period is long. Only when more than two dates remain." },
              { "command": "ifElse", "condition": "=and(=not($.w.skip),=notEquals($.w.cur,$.w.last))",
                "ifScript": [
                  { "command": "set", "path": "$.w.emit", "value": "=fetch($.w.cur)" },
                  { "command": "set", "path": "$.w.last", "value": "=fetch($.w.cur)" },
                  { "command": "set", "path": "$.w.et",
                    "value": "=if(=equals($.w.tag,'IP'),=if(=and($.w.hasCap,=lessOrEqual($.w.emit,$.w.cap)),'IPCI','IP'),$.w.tag)" },
                  { "command": "set", "path": "$.w.raw",
                    "value": "=concat($.w.raw,',',$.w.et,'|',$.w.emit)" },
                  { "command": "ifElse", "condition": "=and(=equals($.w.tag,'IP'),=lessThan($.w.emit,$.statusDate))",
                    "ifScript": [ { "command": "set", "path": "$.w.lastIp", "value": "=fetch($.w.emit)" } ] }
                ] },
              { "command": "set", "path": "$.w.cur", "value": "=fetch($.w.nxt)" },
              { "command": "set", "path": "$.w.k", "value": "=sum($.w.k,1)" }
            ] },
          { "command": "ifElse", "condition": "=equals($.w.inc,1)",
            "ifScript": [
              { "command": "set", "path": "$.w.emit", "value": "=fetch($.maturityDate)" },
              { "command": "set", "path": "$.w.et",
                "value": "=if(=equals($.w.tag,'IP'),=if(=and($.w.hasCap,=lessOrEqual($.w.emit,$.w.cap)),'IPCI','IP'),$.w.tag)" },
              { "command": "set", "path": "$.w.raw",
                "value": "=concat($.w.raw,',',$.w.et,'|',$.w.emit)" },
              { "command": "ifElse", "condition": "=and(=equals($.w.tag,'IP'),=lessThan($.w.emit,$.statusDate))",
                "ifScript": [ { "command": "set", "path": "$.w.lastIp", "value": "=fetch($.w.emit)" } ] }
            ] }
        ] }
  ] },

  { "command": "set", "path": "$.w.raw", "value": "=concat($.w.raw,',IED|',$.initialExchangeDate,',MD|',$.maturityDate)",
    "title": "Single events: IED, MD, purchase, termination, capitalisation end" },
  { "command": "ifElse", "condition": "=fetch($.w.hasPurchase)",
    "ifScript": [ { "command": "set", "path": "$.w.raw", "value": "=concat($.w.raw,',PRD|',$.purchaseDate)" } ] },
  { "command": "ifElse", "condition": "=fetch($.w.hasTermination)",
    "ifScript": [ { "command": "set", "path": "$.w.raw", "value": "=concat($.w.raw,',IP|',$.terminationDate,',TD|',$.terminationDate)" } ] },
  { "command": "ifElse", "condition": "=and($.w.hasCap,=not(=contains(=concat(',',$.w.raw,','),=concat(',IPCI|',$.w.cap,','))))",
    "ifScript": [ { "command": "set", "path": "$.w.raw", "value": "=concat($.w.raw,',IPCI|',$.w.cap)" } ] },

  { "command": "put", "path": "$.w.rawArr", "value": "=split($.w.raw,',')",
    "title": "Sort keys: date | priority | type | scheduled date | calculation date",
    "description": "Event time is the scheduled date moved by the business-day convention. Same-day order is ACTUS priority: IED, IP, IPCI, PRD, TD, RR, RRF, FP, SC, MD. Events before the status date, after a termination or after maturity are dropped here. The first rate reset after the status date becomes an RRF when a next reset rate is given." },
  { "command": "put", "path": "$.w.keys", "value": "" },
  { "command": "put", "path": "$.w.tok", "value": "" },
  { "command": "put", "path": "$.w.stCalc0", "value": "$.statusDate" },
  { "command": "put", "path": "$.w.rrFirst", "value": true },
  { "command": "forEach", "path": "$.w.rawArr", "commands": [
      { "command": "set", "path": "$.w.tok", "value": "=fetch(=scriptpath())" },
      { "command": "put", "path": "$.w.tf", "value": "=split($.w.tok,'|')" },
      { "command": "put", "path": "$.w.ty", "value": "$.w.tf[0]" },
      { "command": "put", "path": "$.w.sd", "value": "$.w.tf[1]" },
      { "command": "put", "path": "$.w.time", "value": "=substring($.w.sd,0,10)" },
      { "command": "put", "path": "$.w.calc",
        "value": "=if(=greaterOrEqual(=datePart($.w.sd,'hour'),12),=dateAdd(=substring($.w.sd,0,10),1,'days'),=substring($.w.sd,0,10))",
        "description": "Calculation date. A time of day of 12:00 or later counts as the next day (the reference case that matures at 23:59:59 accrues a full day)." },
      { "command": "ifElse", "condition": "=fetch($.w.bdActive)",
        "ifScript": [
          { "command": "put", "path": "$.w.dow", "value": "=datePart($.w.time,'dayOfWeek')" },
          { "command": "put", "path": "$.w.fwd",
            "value": "=dateAdd($.w.time,=if(=greaterThan($.w.dow,5),=subtract(8,$.w.dow),0),'days')" },
          { "command": "put", "path": "$.w.prc",
            "value": "=dateAdd($.w.time,=if(=greaterThan($.w.dow,5),=subtract(5,$.w.dow),0),'days')" },
          { "command": "put", "path": "$.w.shifted",
            "value": "=if(=equals($.w.bdKind,'F'),$.w.fwd,=if(=equals($.w.bdKind,'P'),$.w.prc,=if(=equals($.w.bdKind,'MF'),=if(=notEquals(=datePart($.w.fwd,'month'),=datePart($.w.time,'month')),$.w.prc,$.w.fwd),=if(=notEquals(=datePart($.w.prc,'month'),=datePart($.w.time,'month')),$.w.fwd,$.w.prc))))",
            "description": "Monday-to-Friday calendar. F following, P preceding, MF/MP modified: fall back to the other direction when the shift would cross a month end." },
          { "command": "set", "path": "$.w.time", "value": "=fetch($.w.shifted)" },
          { "command": "ifElse", "condition": "=fetch($.w.bdShiftCalc)",
            "ifScript": [ { "command": "set", "path": "$.w.calc", "value": "=fetch($.w.time)" } ] }
        ] },
      { "command": "ifElse", "condition": "=equals($.w.ty,'ST')",
        "ifScript": [ { "command": "set", "path": "$.w.stCalc0", "value": "=fetch($.w.calc)" } ],
        "elseScript": [
          { "command": "ifElse",
            "condition": "=and($.w.hasNext,=and($.w.rrFirst,=and(=equals($.w.ty,'RR'),=greaterThan($.w.time,$.statusDate))))",
            "ifScript": [
              { "command": "set", "path": "$.w.ty", "value": "RRF" },
              { "command": "set", "path": "$.w.rrFirst", "value": false }
            ] },
          { "command": "put", "path": "$.w.prio",
            "value": "=if(=equals($.w.ty,'IED'),0,=if(=equals($.w.ty,'IP'),1,=if(=equals($.w.ty,'IPCI'),2,=if(=equals($.w.ty,'PRD'),3,=if(=equals($.w.ty,'TD'),4,=if(=equals($.w.ty,'RR'),5,=if(=equals($.w.ty,'RRF'),6,=if(=equals($.w.ty,'FP'),7,=if(=equals($.w.ty,'SC'),8,9)))))))))" },
          { "command": "put", "path": "$.w.drop",
            "value": "=or(=lessThan($.w.time,$.statusDate),=or(=greaterThan($.w.time,$.w.mat10),=and($.w.hasTermination,=greaterThan($.w.time,$.w.termination))))" },
          { "command": "ifElse", "condition": "=not($.w.drop)",
            "ifScript": [
              { "command": "set", "path": "$.w.keys",
                "value": "=concat($.w.keys,=if(=equals($.w.keys,''),'',','),$.w.time,'|',$.w.prio,'|',$.w.ty,'|',$.w.sd,'|',$.w.calc)" }
            ] }
        ] }
  ] },
  { "command": "put", "path": "$.events", "value": "=sort(=split($.w.keys,','))" },

  { "command": "put", "path": "$.w.st.notional",
    "value": "=if(=greaterThan($.initialExchangeDate,$.statusDate),0,=multiply($.w.role,$.notionalPrincipal))",
    "title": "Initial state",
    "description": "A contract that started before the status date is already running: notional and rate are set, its IED is not replayed." },
  { "command": "put", "path": "$.w.st.rate",
    "value": "=if(=greaterThan($.initialExchangeDate,$.statusDate),0,=clamp($.nominalInterestRate,$.w.rFloor,$.w.rCap))" },
  { "command": "put", "path": "$.w.st.accrued", "value": "=if(=equals($.nominalInterestRate,0),0,$.accruedInterest)",
    "description": "Interest accrued at the status date: the accruedInterest term when given; otherwise, when there is an interest cycle, the interest since the last interest date before the status date (day count A360 on 360, anything else on 365, as ACTUS-I does); otherwise zero." },
  { "command": "ifElse",
    "condition": "=and(=notEquals($.nominalInterestRate,0),=and(=equals($.accruedInterest,0),=and($.w.hasIpCycle,=notEquals($.w.lastIp,''))))",
    "ifScript": [
      { "command": "put", "path": "$.w.since", "value": "=dateDiff($.w.lastIp,$.statusDate,'days')" },
      { "command": "put", "path": "$.w.sinceBasis", "value": "=if(=equals($.w.dcc,'A360'),360,365)" },
      { "command": "set", "path": "$.w.st.accrued",
        "value": "=multiply(=divide($.w.since,$.w.sinceBasis),$.w.st.notional,$.w.st.rate)" }
    ] },
  { "command": "put", "path": "$.w.st.fee", "value": "=if(=equals($.feeRate,0),0,$.feeAccrued)" },
  { "command": "put", "path": "$.w.st.nsm", "value": "$.notionalScalingMultiplier" },
  { "command": "put", "path": "$.w.st.ism", "value": "$.interestScalingMultiplier" },
  { "command": "put", "path": "$.w.st.sSched", "value": "$.statusDate" },
  { "command": "put", "path": "$.w.st.sCalc", "value": "$.w.stCalc0" },

  { "command": "put", "path": "$.w.key", "value": "",
    "title": "Evaluate the events in order" },
  { "command": "put", "path": "$.w.pay", "value": 0 },
  { "command": "put", "path": "$.w.yf", "value": 0 },
  { "command": "put", "path": "$.w.mr", "value": 0 },
  { "command": "put", "path": "$.w.mrT", "value": "" },
  { "command": "put", "path": "$.w.ts", "value": "" },
  { "command": "put", "path": "$.w.val", "value": 0 },
  { "command": "put", "path": "$.w.rnew", "value": 0 },
  { "command": "put", "path": "$.w.dl", "value": 0 },
  { "command": "put", "path": "$.w.sf", "value": 0 },
  { "command": "forEach", "path": "$.events", "commands": [
      { "command": "set", "path": "$.w.key", "value": "=fetch(=scriptpath())" },
      { "command": "put", "path": "$.w.f", "value": "=split($.w.key,'|')" },
      { "command": "put", "path": "$.w.date", "value": "$.w.f[0]" },
      { "command": "put", "path": "$.w.ty", "value": "$.w.f[2]" },
      { "command": "put", "path": "$.w.sd", "value": "$.w.f[3]" },
      { "command": "put", "path": "$.w.calc", "value": "$.w.f[4]" },
      { "command": "put", "path": "$.w.acc",
        "value": "=or(=equals($.w.ty,'IP'),=or(=equals($.w.ty,'IPCI'),=or(=equals($.w.ty,'RR'),=or(=equals($.w.ty,'FP'),=equals($.w.ty,'SC')))))",
        "description": "IP, IPCI, RR, FP and SC first accrue interest (and fee) from the previous event. RRF does not: ACTUS-I leaves it out of its accrual list, yet still moves the status date, so the interest between the previous event and an RRF is never accrued. The script reproduces that." },
      { "command": "put", "path": "$.w.iedAnc", "value": "=and(=equals($.w.ty,'IED'),$.w.iedAnchorOn)" },

      { "command": "set", "path": "$.w.yf", "value": 0 },
      { "command": "ifElse", "condition": "=or($.w.acc,$.w.iedAnc)",
        "ifScript": [
          { "command": "put", "path": "$.w.ys", "value": "=if($.w.iedAnc,$.interestPaymentAnchor,$.w.st.sCalc)" },
          { "command": "put", "path": "$.w.ye", "value": "=if($.w.iedAnc,$.w.sd,$.w.calc)" },
          { "command": "ifElse", "condition": "=matches($.w.dcc,'^(A360|A365|30E360)$')",
            "ifScript": [
              { "command": "set", "path": "$.w.yf", "value": "=dayCountFraction($.w.ys,$.w.ye,$.w.dcc)" }
            ] },
          { "command": "ifElse", "condition": "=equals($.w.dcc,'A336')",
            "ifScript": [ { "command": "set", "path": "$.w.yf", "value": "=divide(=dateDiff($.w.ys,$.w.ye,'days'),336)" } ] },
          { "command": "ifElse", "condition": "=equals($.w.dcc,'B252')",
            "ifScript": [ { "command": "set", "path": "$.w.yf", "value": "=divide(=dateDiff($.w.ys,$.w.ye,'days'),252)",
              "description": "Business-day count. ACTUS-I hands this convention a calendar in which every day is a business day, so it is the actual day count over 252." } ] },
          { "command": "ifElse", "condition": "=equals($.w.dcc,'30E360ISDA')",
            "ifScript": [
              { "command": "put", "path": "$.w.d1",
                "value": "=if(=equals(=datePart($.w.ys,'day'),=datePart($.w.ys,'daysInMonth')),30,=datePart($.w.ys,'day'))",
                "description": "30E/360 ISDA: the last day of a month counts as the 30th, February included. (ISDA's maturity exception is never armed in ACTUS-I, so it is not here either.)" },
              { "command": "put", "path": "$.w.d2",
                "value": "=if(=equals(=datePart($.w.ye,'day'),=datePart($.w.ye,'daysInMonth')),30,=datePart($.w.ye,'day'))" },
              { "command": "set", "path": "$.w.yf",
                "value": "=divide(=sum(=multiply(360,=subtract(=datePart($.w.ye,'year'),=datePart($.w.ys,'year'))),=multiply(30,=subtract(=datePart($.w.ye,'month'),=datePart($.w.ys,'month'))),=subtract($.w.d2,$.w.d1)),360)" }
            ] },
          { "command": "ifElse", "condition": "=equals($.w.dcc,'AA')",
            "ifScript": [
              { "command": "put", "path": "$.w.y1", "value": "=datePart($.w.ys,'year')",
                "description": "Actual/Actual ISDA: each calendar year's days over that year's length. TLio's dayCountFraction has A360, A365 and 30E360 only." },
              { "command": "put", "path": "$.w.y2", "value": "=datePart($.w.ye,'year')" },
              { "command": "put", "path": "$.w.dim1",
                "value": "=dateDiff(=concat($.w.y1,'-01-01'),=concat(=sum($.w.y1,1),'-01-01'),'days')" },
              { "command": "put", "path": "$.w.dim2",
                "value": "=dateDiff(=concat($.w.y2,'-01-01'),=concat(=sum($.w.y2,1),'-01-01'),'days')" },
              { "command": "ifElse", "condition": "=equals($.w.y1,$.w.y2)",
                "ifScript": [
                  { "command": "set", "path": "$.w.yf", "value": "=divide(=dateDiff($.w.ys,$.w.ye,'days'),$.w.dim1)" }
                ],
                "elseScript": [
                  { "command": "set", "path": "$.w.yf",
                    "value": "=sum(=divide(=dateDiff($.w.ys,=concat(=sum($.w.y1,1),'-01-01'),'days'),$.w.dim1),=divide(=dateDiff(=concat($.w.y2,'-01-01'),$.w.ye,'days'),$.w.dim2),=subtract(=subtract($.w.y2,$.w.y1),1))" }
                ] }
            ] }
        ] },

      { "command": "set", "path": "$.w.pay", "value": 0 },
      { "command": "ifElse", "condition": "=equals($.w.ty,'IED')",
        "ifScript": [ { "command": "set", "path": "$.w.pay",
          "value": "=multiply($.w.role,-1,=sum($.notionalPrincipal,$.premiumDiscountAtIED))" } ] },
      { "command": "ifElse", "condition": "=equals($.w.ty,'IP')",
        "ifScript": [ { "command": "set", "path": "$.w.pay",
          "value": "=multiply($.w.st.ism,=sum($.w.st.accrued,=multiply($.w.yf,$.w.st.rate,$.w.st.notional)))" } ] },
      { "command": "ifElse", "condition": "=equals($.w.ty,'MD')",
        "ifScript": [ { "command": "set", "path": "$.w.pay", "value": "=multiply($.w.st.nsm,$.w.st.notional)" } ] },
      { "command": "ifElse", "condition": "=equals($.w.ty,'PRD')",
        "ifScript": [ { "command": "set", "path": "$.w.pay",
          "value": "=multiply($.w.role,-1,$.priceAtPurchaseDate)" } ] },
      { "command": "ifElse", "condition": "=equals($.w.ty,'TD')",
        "ifScript": [ { "command": "set", "path": "$.w.pay",
          "value": "=multiply($.w.role,$.priceAtTerminationDate)" } ] },
      { "command": "ifElse", "condition": "=equals($.w.ty,'FP')",
        "ifScript": [ { "command": "set", "path": "$.w.pay",
          "value": "=if($.w.feeIsA,=multiply($.w.role,$.feeRate),=sum($.w.st.fee,=multiply($.w.st.notional,$.feeRate,$.w.yf)))" } ] },

      { "command": "ifElse", "condition": "=and($.w.acc,=and(=lessThan($.w.st.sSched,$.w.sd),=notEquals($.w.st.notional,0)))",
        "ifScript": [
          { "command": "ifElse", "condition": "=notEquals($.w.st.rate,0)",
            "ifScript": [ { "command": "set", "path": "$.w.st.accrued",
              "value": "=sum($.w.st.accrued,=multiply($.w.st.rate,$.w.st.notional,$.w.yf))" } ] },
          { "command": "ifElse", "condition": "=and(=notEquals($.feeRate,0),$.w.feeAccrues)",
            "ifScript": [ { "command": "set", "path": "$.w.st.fee",
              "value": "=sum($.w.st.fee,=multiply($.feeRate,$.w.st.notional,$.w.yf))" } ] }
        ] },
      { "command": "set", "path": "$.w.st.sSched", "value": "=fetch($.w.sd)" },
      { "command": "set", "path": "$.w.st.sCalc", "value": "=fetch($.w.calc)" },

      { "command": "ifElse", "condition": "=equals($.w.ty,'IED')",
        "ifScript": [
          { "command": "set", "path": "$.w.st.notional", "value": "=multiply($.w.role,$.notionalPrincipal)" },
          { "command": "set", "path": "$.w.st.rate", "value": "=clamp($.nominalInterestRate,$.w.rFloor,$.w.rCap)" },
          { "command": "ifElse", "condition": "=fetch($.w.iedAnc)",
            "ifScript": [ { "command": "set", "path": "$.w.st.accrued",
              "value": "=sum($.w.st.accrued,=multiply($.w.st.notional,$.w.st.rate,$.w.yf))",
              "description": "Interest for the time between an interest anchor before the IED and the IED itself." } ] } ] },
      { "command": "ifElse", "condition": "=or(=equals($.w.ty,'MD'),=equals($.w.ty,'TD'))",
        "ifScript": [
          { "command": "set", "path": "$.w.st.notional", "value": 0 },
          { "command": "set", "path": "$.w.st.accrued", "value": 0 } ] },
      { "command": "ifElse", "condition": "=equals($.w.ty,'IP')",
        "ifScript": [ { "command": "set", "path": "$.w.st.accrued", "value": 0 } ] },
      { "command": "ifElse", "condition": "=equals($.w.ty,'IPCI')",
        "ifScript": [
          { "command": "set", "path": "$.w.st.notional", "value": "=sum($.w.st.notional,$.w.st.accrued)" },
          { "command": "set", "path": "$.w.st.accrued", "value": 0 } ] },
      { "command": "ifElse", "condition": "=equals($.w.ty,'FP')",
        "ifScript": [ { "command": "set", "path": "$.w.st.fee", "value": 0 } ] },
      { "command": "ifElse", "condition": "=or(=equals($.w.ty,'RR'),=equals($.w.ty,'RRF'))",
        "ifScript": [
          { "command": "set", "path": "$.w.rnew", "value": "=fetch($.w.st.rate)" },
          { "command": "ifElse", "condition": "=equals($.w.ty,'RRF')",
            "ifScript": [ { "command": "set", "path": "$.w.rnew", "value": "=fetch($.nextResetRate)",
              "description": "The first reset after the status date takes the given next reset rate as it is, without life or period bounds." } ] },
          { "command": "ifElse", "condition": "=and(=equals($.w.ty,'RR'),$.w.rrMarket)",
            "ifScript": [
              { "command": "set", "path": "$.w.mr", "value": 0,
                "description": "Market rate: the latest observation at or before the event date (none: 0). New rate = market rate x multiplier + spread; the change is bounded by the period floor and cap, the result by the life floor and cap." },
              { "command": "set", "path": "$.w.mrT", "value": "1900-01-01" },
              { "command": "forEach", "path": "$.marketData", "commands": [
                  { "command": "set", "path": "$.w.ts", "value": "@.timestamp" },
                  { "command": "set", "path": "$.w.val", "value": "@.value" },
                  { "command": "ifElse", "condition": "=and(=lessOrEqual($.w.ts,$.w.date),=greaterThan($.w.ts,$.w.mrT))",
                    "ifScript": [
                      { "command": "set", "path": "$.w.mr", "value": "=fetch($.w.val)" },
                      { "command": "set", "path": "$.w.mrT", "value": "=fetch($.w.ts)" } ] }
              ] },
              { "command": "put", "path": "$.w.rn0", "value": "=sum(=multiply($.w.mr,$.rateMultiplier),$.rateSpread)" },
              { "command": "put", "path": "$.w.rd0", "value": "=subtract($.w.rn0,$.w.st.rate)" },
              { "command": "put", "path": "$.w.rd1", "value": "=max($.w.rd0,$.periodFloor)" },
              { "command": "put", "path": "$.w.rd2", "value": "=min($.w.rd1,$.periodCap)" },
              { "command": "put", "path": "$.w.rn1", "value": "=sum($.w.st.rate,$.w.rd2)" },
              { "command": "put", "path": "$.w.rn2", "value": "=max($.w.rn1,$.lifeFloor)" },
              { "command": "set", "path": "$.w.rnew", "value": "=min($.w.rn2,$.lifeCap)" } ] },
          { "command": "set", "path": "$.w.st.rate",
            "value": "=clamp($.w.rnew,$.w.rFloor,$.w.rCap)" } ] },
      { "command": "ifElse", "condition": "=equals($.w.ty,'SC')",
        "ifScript": [
          { "command": "ifElse", "condition": "=exists($.marketObjectCodeOfScalingIndex)",
            "ifScript": [
              { "command": "set", "path": "$.w.mr", "value": 0,
                "description": "Scaling index: the latest observation at or before the event date (none: 0), over the index at the deal date. The factor times the contract's own multiplier becomes the notional and/or interest scaling multiplier, as the scaling effect says." },
              { "command": "set", "path": "$.w.mrT", "value": "1900-01-01" },
              { "command": "forEach", "path": "$.scalingData", "commands": [
                  { "command": "set", "path": "$.w.ts", "value": "@.timestamp" },
                  { "command": "set", "path": "$.w.val", "value": "@.value" },
                  { "command": "ifElse", "condition": "=and(=lessOrEqual($.w.ts,$.w.date),=greaterThan($.w.ts,$.w.mrT))",
                    "ifScript": [
                      { "command": "set", "path": "$.w.mr", "value": "=fetch($.w.val)" },
                      { "command": "set", "path": "$.w.mrT", "value": "=fetch($.w.ts)" } ] }
              ] },
              { "command": "set", "path": "$.w.sf", "value": "=divide($.w.mr,$.scalingIndexAtContractDealDate)" },
              { "command": "ifElse", "condition": "=fetch($.w.scN)",
                "ifScript": [ { "command": "set", "path": "$.w.st.nsm", "value": "=multiply($.w.sf,$.notionalScalingMultiplier)" } ] },
              { "command": "ifElse", "condition": "=fetch($.w.scI)",
                "ifScript": [ { "command": "set", "path": "$.w.st.ism", "value": "=multiply($.w.sf,$.interestScalingMultiplier)" } ] }
            ] } ] },

      { "command": "set", "path": "@",
        "value": {
          "date": "=fetch($.w.date)",
          "type": "=fetch($.w.ty)",
          "payoff": "=fetch($.w.pay)",
          "notionalPrincipal": "=fetch($.w.st.notional)",
          "nominalInterestRate": "=fetch($.w.st.rate)",
          "accruedInterest": "=fetch($.w.st.accrued)",
          "feeAccrued": "=fetch($.w.st.fee)",
          "drop": "=and($.w.hasPurchase,=or(=and(=notEquals($.w.ty,'AD'),=lessThan($.w.date,$.w.purchase)),=and(=equals($.w.ty,'IP'),=equals($.w.date,$.w.purchase))))"
        } }
  ] },

  { "command": "ifElse", "condition": "=fetch($.w.hasPurchase)",
    "ifScript": [ { "command": "remove", "path": "$.events[?(@.drop==true)]",
      "description": "A purchased contract reports only what happens from the purchase date on. The earlier events are still evaluated: they carry the state." } ] },
  { "command": "remove", "path": "$.events[*].drop" },

  { "command": "add", "path": "$.summary", "value": {} },
  { "command": "add", "path": "$.summary.totalPayoff", "value": "=sum($.events[*].payoff)" },
  { "command": "add", "path": "$.summary.eventCount", "value": "=count($.events)" },
  { "command": "remove", "path": "$.w" }
]
