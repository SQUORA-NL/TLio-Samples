      "type": "collection",
      "timestamp": "=fetch(/ORU_R01/calc/messageTime)",
      "identifier": {
        "value": "=fetch(/ORU_R01/MSH/MSH.10)",
        "assigner": "=fetch(/ORU_R01/MSH/MSH.4)"
      },
