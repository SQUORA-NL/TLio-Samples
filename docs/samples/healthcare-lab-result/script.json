  {
    "command": "put",
    "path": "/ORU_R01/calc/messageTime",
    "title": "Message timestamp as ISO 8601",
    "description": "HL7 v2 writes CCYYMMDDHHMMSS with no separators; FHIR wants an ISO instant. substring and concat is the whole conversion - there is no date type to parse into, because in XML, JSON and YAML alike a date is text.",
    "value": "=concat(=substring(/ORU_R01/MSH/MSH.7,0,4),'-',=substring(/ORU_R01/MSH/MSH.7,4,2),'-',=substring(/ORU_R01/MSH/MSH.7,6,2),'T',=substring(/ORU_R01/MSH/MSH.7,8,2),':',=substring(/ORU_R01/MSH/MSH.7,10,2),':',=substring(/ORU_R01/MSH/MSH.7,12,2),'Z')"
  },
  {
    "command": "put",
    "path": "/ORU_R01/calc/collectedTime",
    "title": "Specimen collection time as ISO 8601",
    "value": "=concat(=substring(/ORU_R01/OBR/OBR.7,0,4),'-',=substring(/ORU_R01/OBR/OBR.7,4,2),'-',=substring(/ORU_R01/OBR/OBR.7,6,2),'T',=substring(/ORU_R01/OBR/OBR.7,8,2),':',=substring(/ORU_R01/OBR/OBR.7,10,2),':',=substring(/ORU_R01/OBR/OBR.7,12,2),'Z')"
  },
  {
    "command": "put",
    "path": "/ORU_R01/calc/birthDate",
    "title": "Birth date as ISO 8601",
    "value": "=concat(=substring(/ORU_R01/PID/PID.7,0,4),'-',=substring(/ORU_R01/PID/PID.7,4,2),'-',=substring(/ORU_R01/PID/PID.7,6,2))"
  },
