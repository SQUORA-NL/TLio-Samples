  {
    "command": "move",
    "fromPath": "/ORU_R01/bundle",
    "toPath": "/",
    "title": "The bundle becomes the document",
    "description": "move to / replaces the document body but keeps the root element's name, so the rename below is what finishes the job. The HL7 message, the map and the working area all go with the body they were part of."
  },
  {
    "command": "rename",
    "path": "/ORU_R01",
    "name": "Bundle",
    "title": "Name the root after what it now holds"
  },
  {
    "command": "convert",
    "to": "json",
    "title": "Emit FHIR as JSON",
    "description": "FHIR is defined in both XML and JSON, but JSON is what an API returns. inferTypes is on so that a lab value becomes a JSON number - FHIR's valueQuantity.value is decimal, not string. The cost is that any all-digit identifier becomes a number too, which the next command puts back.",
    "settings": {
      "inferTypes": true
    }
  },
  {
    "command": "move",
    "fromPath": "$.Bundle",
    "toPath": "$",
    "title": "Unwrap the root element",
    "description": "XML always has exactly one root element, so converting to JSON always produces a document with exactly one top-level key. FHIR wants the Bundle's fields at the top, so the wrapper is moved away. This is the one asymmetry between the two models that a convert cannot resolve on its own."
  },
  {
    "command": "put",
    "path": "$.subject.identifier[0].value",
    "title": "A BSN is text, not a number",
    "description": "This is the price of inferTypes. The AFD 1.0 sample takes the other route - convert first with inferTypes off, then type each field deliberately - and this one command is why that route is usually the better one.",
    "value": "=toString($.subject.identifier[0].value)"
  }
]