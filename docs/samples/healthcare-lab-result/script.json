            "given": [
              "=fetch(/ORU_R01/PID/PID.5.2)"
            ]
          }
        ],
        "gender": "=fetch(/ORU_R01/map/genders/item[hl7 = /ORU_R01/PID/PID.8]/fhir)",
        "birthDate": "=fetch(/ORU_R01/calc/birthDate)"
      },
      "basedOn": {
        "identifier": "=fetch(/ORU_R01/OBR/OBR.2)",
        "panelCode": "=fetch(/ORU_R01/OBR/OBR.4)",
        "requester": "=fetch(/ORU_R01/OBR/OBR.16)"
      },
      "observations": [
        {
          "resourceType": "Observation",
