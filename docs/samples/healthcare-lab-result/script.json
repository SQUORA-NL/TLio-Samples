  {
    "command": "add",
    "path": "/ORU_R01/map",
    "title": "HL7 v2 code tables to FHIR code systems",
    "description": "Three vocabularies that have to be crossed: the lab's own test codes to LOINC, the HL7 abnormal flag to an interpretation code, and the observation status. Adding a test is a data edit here.",
    "value": {
      "testCodes": [
        {
          "local": "KREAT",
          "loinc": "2160-0",
          "display": "Creatinine [Moles/volume] in Serum or Plasma"
        },
        {
