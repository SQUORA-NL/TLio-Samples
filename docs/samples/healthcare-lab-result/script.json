                  "system": "=fetch(/ORU_R01/map/systems/interpretation)",
                  "code": "=fetch(/ORU_R01/map/interpretations/item[hl7 = /ORU_R01/OBX[1]/OBX.8]/code)",
                  "display": "=fetch(/ORU_R01/map/interpretations/item[hl7 = /ORU_R01/OBX[1]/OBX.8]/display)"
                }
