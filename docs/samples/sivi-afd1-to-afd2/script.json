  {
    "command": "copy",
    "fromPath": "$.AFDBERICHT.RECORDS",
    "toPath": "$.afdMessage.policy.coverages",
    "title": "Every record, then only the coverage records",
    "description": "There is one coverage record per requested cover, so the array cannot be written out by hand. A filter cannot be followed by an index here, and copy will not take a filtered fromPath — so the whole record array is copied and the rest is filtered away in the next command."
  },
  {
    "command": "remove",
    "path": "$.afdMessage.policy.coverages[?(@.SRT!='04')]",
    "title": "Drop the non-coverage records",
    "description": "remove does take a filter, and it is applied to the copy, so the AFD 1.0 message is left untouched."
  },
  {
    "command": "put",
    "path": "$.afdMessage.policy.coverages[*].entityType",
    "value": "coverage",
    "title": "Tag every line as an entity",
    "description": "Written before the codes so the AFD 2.0 keys end up in entity order once the AFD 1.0 ones are removed."
  },
  {
    "command": "resolve",
    "path": "$.afdMessage.policy.coverages[*]",
    "title": "Translate every coverage line in place",
    "description": "The per-element form of resolve: one command, every element of the array, each matched on its own AFD 1.0 code. This is the JSON answer to the XPath predicate the two XML samples use.",
    "resolveSettings": [
      {
        "referencesCollectionPath": "$.map.coverageCodes[*]",
        "resolveKeys": [
          {
            "keyPath": "@.AL301",
            "referenceKeyPath": "@.afd1"
          }
        ],
        "values": [
          {
            "targetPath": "@.coverageCode",
            "value": "@.afd2"
          }
        ]
      },
      {
        "referencesCollectionPath": "$.map.coverageStatus[*]",
        "resolveKeys": [
          {
            "keyPath": "@.AL302",
            "referenceKeyPath": "@.afd1"
          }
        ],
        "values": [
          {
            "targetPath": "@.statusCode",
            "value": "@.afd2"
          }
        ]
      }
    ]
  },
  {
    "command": "remove",
    "path": "$.afdMessage.policy.coverages[*].SRT",
    "title": "Drop the AFD 1.0 record fields",
    "description": "What is left on each line is entityType, coverageCode and statusCode - an AFD 2.0 coverage entity."
  },
  {
    "command": "remove",
    "path": "$.afdMessage.policy.coverages[*].AL301"
  },
  {
    "command": "remove",
    "path": "$.afdMessage.policy.coverages[*].AL302"
  },
  {
    "command": "remove",
    "path": "$.AFDBERICHT",
    "title": "Drop the AFD 1.0 message",
    "description": "Everything it carried now exists in AFD 2.0 form."
  },
  {
    "command": "remove",
    "path": "$.map",
    "title": "Drop the code lists"
  },
  {
    "command": "remove",
    "path": "$.calc",
    "title": "Drop the working area"
  }
]