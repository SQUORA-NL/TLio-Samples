          "partyRoleCode": "INTERMEDIARY",
          "agentNumber": "=fetch($.AFDBERICHT.TP_NUMMER)",
          "name": "=fetch($.AFDBERICHT.TP_NAAM)"
        },
        "receiver": {
          "entityType": "party",
          "partyRoleCode": "INSURER",
          "insurerCode": "=fetch($.AFDBERICHT.MIJ_CODE)",
          "name": "=fetch($.AFDBERICHT.MIJ_NAAM)"
        }
      },
      "policy": {
        "entityType": "policy",
        "quotationNumber": "=fetch($.AFDBERICHT.RECORDS[?(@.SRT=='01')].AL001)",
        "policyNumber": null,
        "productCode": "=fetch($.AFDBERICHT.RECORDS[?(@.SRT=='01')].AL002)",
        "commencementDate": "=concat(=substring($.AFDBERICHT.RECORDS[?(@.SRT=='01')].AL003,0,4),'-',=substring($.AFDBERICHT.RECORDS[?(@.SRT=='01')].AL003,4,2),'-',=substring($.AFDBERICHT.RECORDS[?(@.SRT=='01')].AL003,6,2))",
