  {
    "command": "put",
    "path": "$.calc.codes",
    "title": "Every coded field, still in AFD 1.0",
    "description": "Collected into one node so that one resolve can translate all of them. A JSONPath filter can test a record against a literal, but it cannot compare it to another part of the document the way an XPath predicate can — which is exactly why the JSON side needs a lookup command where the XML samples need none.",
    "value": {
      "messageType": "=fetch($.AFDBERICHT.BERICHTSOORT)",
      "collectionMethod": "=fetch($.AFDBERICHT.RECORDS[?(@.SRT=='01')].AL008)",
      "requestedCoverage": "=fetch($.AFDBERICHT.RECORDS[?(@.SRT=='01')].AL005)",
      "partyRole1": "=fetch($.AFDBERICHT.RECORDS[?(@.SRT=='02' && @.AL101=='01')].AL101)",
      "partyType1": "=fetch($.AFDBERICHT.RECORDS[?(@.SRT=='02' && @.AL101=='01')].AL102)",
      "partyRole2": "=fetch($.AFDBERICHT.RECORDS[?(@.SRT=='02' && @.AL101=='02')].AL101)",
      "partyType2": "=fetch($.AFDBERICHT.RECORDS[?(@.SRT=='02' && @.AL101=='02')].AL102)",
      "objectType": "=fetch($.AFDBERICHT.RECORDS[?(@.SRT=='03')].AL201)",
      "usage": "=fetch($.AFDBERICHT.RECORDS[?(@.SRT=='03')].AL208)",
      "parking": "=fetch($.AFDBERICHT.RECORDS[?(@.SRT=='03')].AL209)",
      "security": "=fetch($.AFDBERICHT.RECORDS[?(@.SRT=='03')].AL210)"
    }
  },
  {
    "command": "resolve",
    "path": "$.calc.codes",
    "title": "Eleven code lists, one command",
    "description": "Each setting joins one AFD 1.0 value to its AFD 2.0 spelling and writes the result alongside it. resolve is the JSON answer to the XPath predicate the two XML samples use.",
    "resolveSettings": [
      {
        "referencesCollectionPath": "$.map.messageTypes[*]",
        "resolveKeys": [
          {
            "keyPath": "@.messageType",
            "referenceKeyPath": "@.afd1"
          }
        ],
        "values": [
          {
            "targetPath": "@.messageTypeOut",
            "value": "@.afd2"
          }
        ]
      },
      {
