[
  {
    "command": "convert",
    "to": "json",
    "title": "AFD 1.0 XML becomes JSON",
    "description": "The boundary comes first, because everything this script does is easier on the other side of it. AFD 1.0 is a flat file: every field is text, so inferTypes stays off and the script decides itself which fields are numbers. Paths above this line are XPath; below it they are JSONPath.",
    "settings": {
      "inferTypes": false
    }
  },
