            "genderCode": "=fetch($.AFDBERICHT.RECORDS[?(@.SRT=='02' && @.AL101=='01')].AL107)",
            "street": "=fetch($.AFDBERICHT.RECORDS[?(@.SRT=='02' && @.AL101=='01')].AL108)",
