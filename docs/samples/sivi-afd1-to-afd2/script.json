  {
    "command": "put",
    "path": "$.afdMessage",
    "title": "The whole AFD 2.0 message, in one command",
    "description": "An object-valued put evaluates every =fetch inside it as the object is written, at any depth — so the entire 1.0-to-2.0 mapping is a single command that reads like a mapping table. Dates go from CCYYMMDD to ISO with substring and concat; amounts go from cents to euros with divide, which is also what turns the AFD 1.0 text into a JSON number.",
    "value": {
      "messageHeader": {
        "messageId": "=fetch($.AFDBERICHT.BERICHTNR)",
        "messageTypeCode": "=fetch($.calc.codes.messageTypeOut)",
        "afdVersion": "2.0",
        "messageDate": "=concat(=substring($.AFDBERICHT.BERICHTDATUM,0,4),'-',=substring($.AFDBERICHT.BERICHTDATUM,4,2),'-',=substring($.AFDBERICHT.BERICHTDATUM,6,2))",
        "sender": {
